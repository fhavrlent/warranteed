# Public URL of this app, exactly as you open it in the browser.
# The OIDC redirect URI is this + /auth/callback
WARRANTEED_APP_URL=https://warranty.example.com

# Timezone for "expires today" and reminder times.
TZ=Europe/Prague

# ---- Sign-in (OpenID Connect) ----
# Pocket ID: create an OIDC client with callback URL
#   https://warranty.example.com/auth/callback
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE is always used).
OIDC_CLIENT_SECRET=
# Label on the login button.
OIDC_PROVIDER_NAME=Pocket ID
# Optional: only members of these groups may sign in (comma separated).
OIDC_ALLOWED_GROUPS=
# Optional: members of these groups are admins. Without it, the first user is admin.
OIDC_ADMIN_GROUPS=
# Skip the login page and go straight to the provider.
OIDC_AUTO_REDIRECT=false

# ---- Paperless-ngx (optional) ----
# Server-wide connection; each user can also set their own in Settings.
PAPERLESS_URL=
PAPERLESS_TOKEN=
# If the URL above is internal (e.g. http://paperless:8000), the address
# your browser uses for "Open in Paperless" links.
PAPERLESS_PUBLIC_URL=

# ---- Other ----
# Hour of day (0-23) at which expiry reminders are sent.
WARRANTEED_NOTIFY_HOUR=9
WARRANTEED_MAX_UPLOAD_MB=50
# Where uploaded files go (default: /data/files). May be a network share;
# the database in /data must stay on local disk.
#WARRANTEED_FILES_DIR=/files
WARRANTEED_SESSION_DAYS=30
